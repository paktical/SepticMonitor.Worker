// Copy this file to appsettings.Local.json and edit for your machine.
// appsettings.Local.json is git-ignored, so real hosts and broker credentials
// never reach the repo. Every key is optional - anything you omit falls back to
// the committed defaults in appsettings.json.
{
  "ConnectionStrings": {
    "MonitorDb": "Data Source=septic-monitor.db"
  },
  "Mqtt": {
    "Host": "192.168.1.50",
    "Port": 1883,
    "Username": "your-broker-user",
    "Password": "your-broker-password"
  },
  "Device": {
    "Id": "hp80-01"
  },
  "Monitor": {
    "FailGraceSeconds": 5,
    "OfflineGraceSeconds": 30,
    "PollIntervalSeconds": 1
  }
}
