{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "MonitorDb": "Data Source=septic-monitor.db"
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "septic-worker",
    "TopicFilter": "septic/#",
    "AlertTopic": "septic/hp80/alert",
    "Username": null,
    "Password": null,
    "ReconnectDelaySeconds": 3,
    "RetainAlerts": true
  },
  "Device": {
    "Id": "hp80-01"
  },
  "Monitor": {
    "FailGraceSeconds": 5,
    "OfflineGraceSeconds": 30,
    "PollIntervalSeconds": 1
  }
}
